# ============================================
# YouTube Trend Tracker — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# Place .env at the monorepo ROOT directory

# Supabase Keys
# Get these from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Next.js public keys (same values as above — needed for client-side access)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# YouTube Data API v3
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY="AIzaSyA..."

# Target YouTube Channels (comma-separated)
# Supports: URLs, @handles, or Channel IDs
# Examples:
#   "https://www.youtube.com/@Theghostradio"
#   "@Theghostradio"
#   "UCxxxxxx"
#   "https://www.youtube.com/@Channel1,@Channel2,UCxxxxxx"
TARGET_CHANNEL_IDS="https://www.youtube.com/@Theghostradio"

# Cron Schedule (default: every 2 hours)
# Format: standard cron expression
CRON_INTERVAL="0 */2 * * *"
